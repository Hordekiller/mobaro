Options -Indexes

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)$|package(-lock)?\.json$|phpunit\.xml$|phpcs\.xml$|.*\.(sql|log|bak|zip|tar|gz)$)">
    Require all denied
</FilesMatch>

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Allow setup-admin.php
RewriteRule ^setup-admin\.php$ - [L]

# Block sensitive directories
RewriteRule ^(?:app|database|storage|tests|vendor|analysis-output|skills)(?:/|$) - [F,L,NC]
RewriteRule ^(?:README(?:\.[A-Za-z0-9_-]+)?|REPORT-[^/]+\.md)$ - [F,L,NC]

# Front controller
RewriteRule ^(.*)$ public/$1 [L]
