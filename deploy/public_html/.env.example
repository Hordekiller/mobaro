APP_NAME=Mobaro
APP_URL=https://mobaro.ir
APP_ENV=production
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=mobaro
DB_USER=mobaro_user
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

CACHE_PREFIX=mobaro
CACHE_TTL_DEFAULT=3600
CACHE_TTL_PAGE=600
CACHE_TTL_ADMIN=300

ZARINPAL_MERCHANT_ID=your_merchant_id_here
ZARINPAL_SANDBOX=false

SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TTL=180
SMS_OTP_LENGTH=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mobaro.ir/auth/google/callback
