{
    "name": "mobaro/mvc",
    "description": "Mobaro beauty salon MVC application",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "analyse:baseline": "phpstan analyse --no-progress --generate-baseline"
    }
}
