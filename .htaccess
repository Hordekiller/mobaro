Options -Indexes

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)$|package(-lock)?\.json$|phpunit\.xml$|phpcs\.xml$|sonar-project\.properties$|.*\.(sql|log|bak|zip|tar|gz)$)">
    Require all denied
</FilesMatch>

RewriteEngine On

# Force HTTPS + non-www (single hop, no loop)
# 1) www → non-www
RewriteCond %{HTTP_HOST} ^www\.mobaro\.ir$ [NC]
RewriteRule ^(.*)$ https://mobaro.ir/$1 [L,R=301,NE]

# 2) HTTP → HTTPS (only for non-www, after step 1)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP:X-Forwarded-SSL} !=on
RewriteRule ^ https://mobaro.ir%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^(?:app|database|storage|tests|vendor|analysis-output|skills|_do_not_upload)(?:/|$) - [F,L,NC]
RewriteRule ^(?:README(?:\.[A-Za-z0-9_-]+)?|REPORT-[^/]+\.md)$ - [F,L,NC]

# Allow the installer before the front-controller rewrite
RewriteRule ^install\.php$ - [L]

RewriteRule ^(.*)$ public/$1 [L]
